#version 460
// smrast_bin.comp — SmRast-VK v0.7 (Pure-Triangle Hopper-Optimized Hot Kernel):
//   - Cooperative Zero-Atomic Small-Triangle Fast-Path (<=8 tris: 64-way parallel row-major active_tiles, 0 CmdUpdateBuffer, 0 global atomics!)
//   - Multi-Draw Uber-Batching support (clip_vert_base + tri_setup_base for barrier-free parallel Binning!)
//   - Hybrid Coherent-2D (giant 1M+ meshes) + GPU Active-Tile Compaction (small/medium draws)
//   - Exact 2-Plane Sutherland-Hodgman Clipping (Standard-Z z>=0 AND Reverse-Z z<=w!)
//   - Coarse Pre-Binning Hi-Z Early-Reject + CuRast (<=64 px) 64-bit Atomic Fast-Path + CUDARaster 16x16 Binning
//   - Watertight Top-Left Fill-Rule + 4-bit (1/16 px) Subpixel Snapping + DepthBias + DepthClamp + PrimRestart (0x7FC0DEADu)
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_shader_atomic_int64 : require

layout(local_size_x = 64) in;

struct TriSetup {
    vec4 v0;     // sx, sy, ndc_z, inv_w
    vec4 v1;     // sx, sy, ndc_z, inv_w
    vec4 v2;     // sx, sy, ndc_z, inv_w
    vec4 area;   // inv_area, minx, miny, maxx
    uvec4 idx;   // i0, i1, i2, maxy | (is_front << 31)
};

layout(std430, set = 0, binding = 0) buffer ClipVertBuf         { vec4 clip_verts[]; };
layout(std430, set = 0, binding = 1) buffer TriSetupBuf         { TriSetup tris[]; };
layout(std430, set = 0, binding = 2) buffer TileCountBuf        { uint tile_counts[]; };
layout(std430, set = 0, binding = 3) buffer TileBinsBuf         { uint tile_bins[]; };
layout(std430, set = 0, binding = 4) buffer VisBuf              { uint64_t vis_px[]; };
layout(std430, set = 0, binding = 5) readonly buffer DepthBuf   { float depth_px[]; };
layout(std430, set = 0, binding = 6) writeonly buffer ActBuf    { uint active_tiles[]; };
layout(std430, set = 0, binding = 7) buffer DispCmdBuf          { uint disp_cmds[]; };
layout(std430, set = 0, binding = 8) readonly buffer TileHizBuf { vec2 tile_hiz[]; };

layout(push_constant) uniform BinParams {
    uint tri_count;
    uint vert_stride_vec4;
    uint width;
    uint height;
    uint tiles_x;
    uint tiles_y;
    uint max_tris_per_tile;
    uint flags; // bit0=cull_back, bit1=cull_front, bit2=front_cw, bit3=depth_test,
                // bits4..6=depth_op, bits8..10=topo, bit11=depth_clamp, bit12=depth_bias,
                // bit13=use_prebin_hiz, bit14=has_point_size, bit15=direct_2d, bit16=small_tri_coop
    float vp_x;
    float vp_y;
    float vp_w;
    float vp_h;
    float vp_min_d;
    float vp_max_d;
    int sc_x0;
    int sc_y0;
    int sc_x1;
    int sc_y1;
    uint tris_per_inst;
    uint verts_per_inst;
    uint extra_vert_base;
    uint extra_tri_base;
    float depth_bias_const;
    float depth_bias_slope;
    float depth_bias_clamp;
    float line_width;
    uint clip_vert_base;
    uint tri_setup_base;
    uint flags2; // bit0=last_pv, bit1=prim_restart, bit2=peel_mode(no CuRast bypass), bit3=has_clip_dist,
                 // bit4=has_cull_dist, bits5..7=clip_cnt(0..7->1..8), bits8..10=cull_cnt, bit11=depth_bounds_en, bit12=late_z
    float min_db;
    float max_db;
    uint clip_cull_slot;
} pc;

// Shared state for 1-workgroup zero-atomic cooperative small-triangle binning (bit 16)
shared uint s_clip_v;
shared uint s_clip_t;
shared uint s_out_n;
shared uint s_tx0;
shared uint s_ty0;
shared uint s_tx1;
shared uint s_ty1;

// Shared queue for 64-way warp-cooperative large-triangle binning (>32 tiles -> 64x faster on giant triangles!)
shared uint  s_big_cnt;
shared uint  s_big_tid[64];
shared uvec4 s_big_bb[64];
shared vec2  s_big_z[64];

bool depth_pass(float d, float ref_d, uint op) {
    if (op == 0u) return false;
    if (op == 1u) return d < ref_d;
    if (op == 4u) return d > ref_d;
    if (op == 5u) return d != ref_d;
    if (op == 7u) return true;
    // Cross-pass Depth-PrePass -> G-Buffer invariance tolerance (16 ULP ~ 1.9e-6 relative)
    // compensates for cross-shader FMA contraction between DepthOnly VS/FS and G-Buffer VS/Fine.
    uint du = floatBitsToUint(d) & 0x7FFFFFFFu;
    uint ru = floatBitsToUint(ref_d) & 0x7FFFFFFFu;
    if (op == 2u) return (du >= ru ? (du - ru) : (ru - du)) <= 16u;
    if (op == 3u) return du <= ru + 16u;
    if (op == 6u) return du + 16u >= ru;
    return true;
}

bool hiz_tile_pass(float tri_min_z, float tri_max_z, vec2 hz, uint dop) {
    if (dop == 1u) return tri_min_z <  hz.y;
    if (dop == 3u) return (floatBitsToUint(tri_min_z) & 0x7FFFFFFFu) <= (floatBitsToUint(hz.y) & 0x7FFFFFFFu) + 16u;
    if (dop == 4u) return tri_max_z >  hz.x;
    if (dop == 6u) return (floatBitsToUint(tri_max_z) & 0x7FFFFFFFu) + 16u >= (floatBitsToUint(hz.x) & 0x7FFFFFFFu);
    return true;
}

bool is_top_left(vec2 d) {
    return (d.y < 0.0) || (d.y == 0.0 && d.x > 0.0);
}

float edge_eval(vec2 a, vec2 b, float fx, float fy) {
    if (a.y < b.y || (a.y == b.y && a.x < b.x)) {
        vec2 d = b - a;
        return d.x * (fy - a.y) - d.y * (fx - a.x);
    } else {
        vec2 d = a - b;
        return -(d.x * (fy - b.y) - d.y * (fx - b.x));
    }
}

vec4 make_edge(vec2 a, vec2 b) {
    if (a.y < b.y || (a.y == b.y && a.x < b.x)) {
        vec2 d = b - a;
        return vec4(a.x, a.y, d.x, d.y);
    } else {
        vec2 d = a - b;
        return vec4(b.x, b.y, -d.x, -d.y);
    }
}

// Conservative CUDARaster triangle-vs-tile edge trivial-reject (skips empty diagonal tiles before atomicAdd!)
bool tri_overlaps_tile(vec4 e0, vec4 e1, vec4 e2, uint tx, uint ty) {
    float x0 = float(tx * 16u), x1 = x0 + 16.0;
    float y0 = float(ty * 16u), y1 = y0 + 16.0;
    float r0x = (e0.w < 0.0) ? x1 : x0;
    float r0y = (e0.z > 0.0) ? y1 : y0;
    if (e0.z * (r0y - e0.y) - e0.w * (r0x - e0.x) < 0.0) return false;
    float r1x = (e1.w < 0.0) ? x1 : x0;
    float r1y = (e1.z > 0.0) ? y1 : y0;
    if (e1.z * (r1y - e1.y) - e1.w * (r1x - e1.x) < 0.0) return false;
    float r2x = (e2.w < 0.0) ? x1 : x0;
    float r2y = (e2.z > 0.0) ? y1 : y0;
    if (e2.z * (r2y - e2.y) - e2.w * (r2x - e2.x) < 0.0) return false;
    return true;
}

void mark_tile_active(uint tile_id) {
    uint flag_idx = pc.tiles_x * pc.tiles_y + 8u + tile_id;
    if (tile_counts[flag_idx] == 0u) {
        if (atomicExchange(tile_counts[flag_idx], 1u) == 0u) {
            uint slot = atomicAdd(disp_cmds[8u], 1u);
            active_tiles[slot] = tile_id;
        }
    }
}

void emit_interp_vert(uint dst_idx, uint ia, uint ib, float t) {
    uint base_d = dst_idx * pc.vert_stride_vec4;
    uint base_a = ia * pc.vert_stride_vec4;
    uint base_b = ib * pc.vert_stride_vec4;
    for (uint k = 0u; k < pc.vert_stride_vec4; ++k) {
        clip_verts[base_d + k] = mix(clip_verts[base_a + k], clip_verts[base_b + k], t);
    }
}

void process_tri(uint tid, uint i0, uint i1, uint i2, vec4 c0, vec4 c1, vec4 c2) {
    if (!(c0.w > 1e-6 && c1.w > 1e-6 && c2.w > 1e-6)) return;
    if (any(isnan(c0)) || any(isnan(c1)) || any(isnan(c2)) ||
        any(isinf(c0)) || any(isinf(c1)) || any(isinf(c2))) return;

    bool depth_clamp = (pc.flags & 2048u) != 0u;
    if ((c0.x < -c0.w && c1.x < -c1.w && c2.x < -c2.w) ||
        (c0.x >  c0.w && c1.x >  c1.w && c2.x >  c2.w) ||
        (c0.y < -c0.w && c1.y < -c1.w && c2.y < -c2.w) ||
        (c0.y >  c0.w && c1.y >  c1.w && c2.y >  c2.w) ||
        (!depth_clamp && c0.z > c0.w && c1.z > c1.w && c2.z > c2.w)) return;

    float invw0 = 1.0 / c0.w;
    float invw1 = 1.0 / c1.w;
    float invw2 = 1.0 / c2.w;

    vec2 s0 = round(vec2(pc.vp_x + (c0.x * invw0 * 0.5 + 0.5) * pc.vp_w,
                         pc.vp_y + (c0.y * invw0 * 0.5 + 0.5) * pc.vp_h) * 16.0) * 0.0625;
    vec2 s1 = round(vec2(pc.vp_x + (c1.x * invw1 * 0.5 + 0.5) * pc.vp_w,
                         pc.vp_y + (c1.y * invw1 * 0.5 + 0.5) * pc.vp_h) * 16.0) * 0.0625;
    vec2 s2 = round(vec2(pc.vp_x + (c2.x * invw2 * 0.5 + 0.5) * pc.vp_w,
                         pc.vp_y + (c2.y * invw2 * 0.5 + 0.5) * pc.vp_h) * 16.0) * 0.0625;

    float z0 = pc.vp_min_d + (c0.z * invw0) * (pc.vp_max_d - pc.vp_min_d);
    float z1 = pc.vp_min_d + (c1.z * invw1) * (pc.vp_max_d - pc.vp_min_d);
    float z2 = pc.vp_min_d + (c2.z * invw2) * (pc.vp_max_d - pc.vp_min_d);

    float area = (s1.x - s0.x) * (s2.y - s0.y) - (s1.y - s0.y) * (s2.x - s0.x);
    if (!(abs(area) >= 1e-6)) return;

    bool front_cw = (pc.flags & 4u) != 0u;
    bool is_front = front_cw ? (area > 0.0) : (area < 0.0);
    bool cull_back  = (pc.flags & 1u) != 0u;
    bool cull_front = (pc.flags & 2u) != 0u;
    if ((cull_back && !is_front) || (cull_front && is_front)) return;

    if (area < 0.0) {
        vec2 ts = s1; s1 = s2; s2 = ts;
        float tz = z1; z1 = z2; z2 = tz;
        float tw = invw1; invw1 = invw2; invw2 = tw;
        uint ti = i1; i1 = i2; i2 = ti;
        area = -area;
    }

    int minx = max(pc.sc_x0, int(floor(clamp(min(s0.x, min(s1.x, s2.x)), -1e6, 1e6))));
    int miny = max(pc.sc_y0, int(floor(clamp(min(s0.y, min(s1.y, s2.y)), -1e6, 1e6))));
    int maxx = min(pc.sc_x1 - 1, int(ceil(clamp(max(s0.x, max(s1.x, s2.x)), -1e6, 1e6))));
    int maxy = min(pc.sc_y1 - 1, int(ceil(clamp(max(s0.y, max(s1.y, s2.y)), -1e6, 1e6))));
    if (minx > maxx || miny > maxy) return;

    float inv_area = 1.0 / area;

    if ((pc.flags & 4096u) != 0u) {
        float dzdx = (-(s2.y - s1.y) * z0 - (s0.y - s2.y) * z1 - (s1.y - s0.y) * z2) * inv_area;
        float dzdy = ( (s2.x - s1.x) * z0 + (s0.x - s2.x) * z1 + (s1.x - s0.x) * z2) * inv_area;
        float max_slope = max(abs(dzdx), abs(dzdy));
        float bias = pc.depth_bias_const * 5.9604645e-8 + pc.depth_bias_slope * max_slope;
        if (pc.depth_bias_clamp > 0.0) bias = min(bias, pc.depth_bias_clamp);
        else if (pc.depth_bias_clamp < 0.0) bias = max(bias, pc.depth_bias_clamp);
        z0 += bias; z1 += bias; z2 += bias;
    }

    uint tx0 = uint(minx) >> 4u;
    uint ty0 = uint(miny) >> 4u;
    uint tx1 = min(pc.tiles_x - 1u, uint(maxx) >> 4u);
    uint ty1 = min(pc.tiles_y - 1u, uint(maxy) >> 4u);

    bool late_z    = (pc.flags2 & 4096u) != 0u;
    bool dtest     = ((pc.flags & 8u) != 0u) && !late_z;
    uint dop       = (pc.flags >> 4u) & 7u;
    bool use_hiz   = ((pc.flags & 8192u) != 0u) && !late_z;
    bool direct_2d = (pc.flags & 32768u) != 0u;
    bool peel_mode = (pc.flags2 & 4u) != 0u;
    bool db_en     = (pc.flags2 & 2048u) != 0u;
    float tri_min_z = clamp(min(z0, min(z1, z2)), 0.0, 1.0);
    float tri_max_z = clamp(max(z0, max(z1, z2)), 0.0, 1.0);

    TriSetup ts;
    ts.v0   = vec4(s0, z0, invw0);
    ts.v1   = vec4(s1, z1, invw1);
    ts.v2   = vec4(s2, z2, invw2);
    ts.area = vec4(inv_area, float(minx), float(miny), float(maxx));
    // Pack maxy[0..15] | draw_id[16..23] | is_front[31] (zero struct bloat!)
    ts.idx  = uvec4(i0, i1, i2, (uint(maxy) & 0xFFFFu) | (((pc.flags >> 20u) & 0xFFu) << 16u) | (is_front ? 0x80000000u : 0u));

    // v0.7 Fused Quad FS Fast-Path (bit 17 = 131072u): writes TriSetup[0..7] directly for FS — ZERO Fine, ZERO VisBuf, ZERO Indirect!
    if ((pc.flags & 131072u) != 0u) {
        // Pack painter's order (tid & 0x7Fu) into bits 24..30 so overlapping 2-tri draws obey API draw order!
        ts.idx.w = (ts.idx.w & 0x80FFFFFFu) | ((tid & 0x7Fu) << 24u);
        uint slot = atomicAdd(s_out_n, 1u);
        if (slot < 8u) tris[slot] = ts;
        return;
    }

    // v0.7 Cooperative Zero-Atomic Small-Triangle Fast-Path (<=8 tris: post-process, skybox, fog, UI, video):
    // Accumulates union tile AABB in shared memory -> all 64 threads fill active_tiles[] in parallel with 0 global atomics!
    if ((pc.flags & 65536u) != 0u) {
        tris[tid] = ts;
        uint slot = atomicAdd(s_out_n, 1u);
        if (slot < 64u) tile_bins[slot] = tid;
        atomicMin(s_tx0, tx0);
        atomicMin(s_ty0, ty0);
        atomicMax(s_tx1, tx1);
        atomicMax(s_ty1, ty1);
        return;
    }

    int bw = maxx - minx + 1;
    int bh = maxy - miny + 1;
    vec4 e0 = make_edge(s1, s2);
    vec4 e1 = make_edge(s2, s0);
    vec4 e2 = make_edge(s0, s1);

    // v0.9 CuRast Micro-Triangle Fast-Path (disabled during peel_mode so ALL tris enter tile_bins for exact GPU depth peeling!)
    if (!peel_mode && bw * bh <= 128) {
        if (use_hiz) {
            bool any_pass = false;
            for (uint ty = ty0; ty <= ty1 && !any_pass; ++ty) {
                for (uint tx = tx0; tx <= tx1; ++tx) {
                    if (hiz_tile_pass(tri_min_z, tri_max_z, tile_hiz[ty * pc.tiles_x + tx], dop)) {
                        any_pass = true;
                        break;
                    }
                }
            }
            if (!any_pass) return;
        }
        tris[tid] = ts;
        bool greater_wins = (dop == 4u || dop == 6u);
        bool tl0 = is_top_left(s2 - s1), tl1 = is_top_left(s0 - s2), tl2 = is_top_left(s1 - s0);
        bool wrote_any = false;
        for (int py = miny; py <= maxy; ++py) {
            float fy = float(py) + 0.5;
            for (int px = minx; px <= maxx; ++px) {
                float fx = float(px) + 0.5;
                float ev0 = e0.z * (fy - e0.y) - e0.w * (fx - e0.x);
                if (tl0 ? (ev0 < 0.0) : (ev0 <= 0.0)) continue;
                float ev1 = e1.z * (fy - e1.y) - e1.w * (fx - e1.x);
                if (tl1 ? (ev1 < 0.0) : (ev1 <= 0.0)) continue;
                float ev2 = e2.z * (fy - e2.y) - e2.w * (fx - e2.x);
                if (tl2 ? (ev2 < 0.0) : (ev2 <= 0.0)) continue;
                float l0 = ev0 * inv_area;
                float l1 = ev1 * inv_area;
                float l2 = 1.0 - l0 - l1;
                float d = clamp(l0 * z0 + l1 * z1 + l2 * z2, 0.0, 1.0);
                if (!(d >= 0.0 && d <= 1.0)) continue;
                uint pidx = uint(py) * pc.width + uint(px);
                if (db_en) {
                    float rz = depth_px[pidx];
                    if (rz < pc.min_db || rz > pc.max_db) continue;
                }
                if (dtest && !depth_pass(d, depth_px[pidx], dop)) continue;
                uint64_t packed;
                if (!dtest || dop == 7u) {
                    // Painter's order: upper 32 bits = ~tid (larger tid wins atomicMin), low 32 bits = tid
                    packed = (uint64_t(~tid) << 32) | uint64_t(tid);
                } else {
                    uint du = floatBitsToUint(d) & 0x7FFFFFFFu;
                    uint d_u32 = greater_wins ? (0x3F800000u - du) : du;
                    packed = (uint64_t(d_u32) << 32) | uint64_t(tid);
                }
                atomicMin(vis_px[pidx], packed);
                wrote_any = true;
            }
        }
        if (wrote_any && !direct_2d) {
            for (uint ty = ty0; ty <= ty1; ++ty) {
                for (uint tx = tx0; tx <= tx1; ++tx) {
                    mark_tile_active(ty * pc.tiles_x + tx);
                }
            }
        }
        return;
    }

    uint ntiles = (tx1 - tx0 + 1u) * (ty1 - ty0 + 1u);
    if (ntiles > 32u) {
        tris[tid] = ts;
        uint bslot = atomicAdd(s_big_cnt, 1u);
        if (bslot < 64u) {
            s_big_tid[bslot] = tid;
            s_big_bb[bslot]  = uvec4(tx0, ty0, tx1, ty1);
            s_big_z[bslot]   = vec2(tri_min_z, tri_max_z);
            return;
        }
    }

    bool wrote_ts = (ntiles > 32u);
    for (uint ty = ty0; ty <= ty1; ++ty) {
        for (uint tx = tx0; tx <= tx1; ++tx) {
            if (!tri_overlaps_tile(e0, e1, e2, tx, ty)) continue;
            uint tile_id = ty * pc.tiles_x + tx;
            if (use_hiz && !hiz_tile_pass(tri_min_z, tri_max_z, tile_hiz[tile_id], dop)) continue;
            if (!wrote_ts) { tris[tid] = ts; wrote_ts = true; }
            uint slot = atomicAdd(tile_counts[tile_id], 1u);
            if (slot < pc.max_tris_per_tile) {
                tile_bins[tile_id * pc.max_tris_per_tile + slot] = tid;
                if (slot == 0u && !direct_2d) mark_tile_active(tile_id);
            }
        }
    }
}

void run_one_tri(uint tid, uint meta_idx, bool small_coop, uint eff_tpi, uint eff_vpi, uint eff_cv_base, uint eff_ts_base) {
    uint inst_local = tid / max(eff_tpi, 1u);
    uint tri_local  = tid - inst_local * max(eff_tpi, 1u);
    uint vbase      = eff_cv_base + inst_local * eff_vpi;
    uint gtid       = eff_ts_base + tid;

    uint topo = (pc.flags >> 8u) & 7u;
    bool last_pv = (pc.flags2 & 1u) != 0u;
    uint i0, i1, i2;
    if (topo == 0u) {
        if (!last_pv) {
            i0 = vbase + tri_local * 3u + 0u;
            i1 = vbase + tri_local * 3u + 1u;
            i2 = vbase + tri_local * 3u + 2u;
        } else {
            i0 = vbase + tri_local * 3u + 2u;
            i1 = vbase + tri_local * 3u + 0u;
            i2 = vbase + tri_local * 3u + 1u;
        }
    } else if (topo == 1u) {
        // Vulkan 1.3 spec-exact TRIANGLE_STRIP winding + provoking vertex (i0) + primitive-restart parity reset!
        uint parity = tri_local & 1u;
        if ((pc.flags2 & 2u) != 0u && tri_local > 0u) {
            uint strip_start = 0u;
            uint back_lim = min(tri_local, 256u);
            for (uint bk = 1u; bk <= back_lim; ++bk) {
                uint prev_v = vbase + tri_local - bk;
                if (floatBitsToUint(clip_verts[prev_v * pc.vert_stride_vec4].w) == 0x7FC0DEADu) {
                    strip_start = tri_local - bk + 1u;
                    break;
                }
            }
            parity = (tri_local - strip_start) & 1u;
        }
        if (parity == 0u) {
            if (!last_pv) { i0 = vbase + tri_local;      i1 = vbase + tri_local + 1u; i2 = vbase + tri_local + 2u; }
            else          { i0 = vbase + tri_local + 2u; i1 = vbase + tri_local;      i2 = vbase + tri_local + 1u; }
        } else {
            if (!last_pv) { i0 = vbase + tri_local;      i1 = vbase + tri_local + 2u; i2 = vbase + tri_local + 1u; }
            else          { i0 = vbase + tri_local + 2u; i1 = vbase + tri_local + 1u; i2 = vbase + tri_local;      }
        }
    } else {
        // TRIANGLE_FAN: provoking vertex is tri_local+1 (FIRST) or tri_local+2 (LAST); cyclic rotation preserves exact winding!
        if (!last_pv) { i0 = vbase + tri_local + 1u; i1 = vbase + tri_local + 2u; i2 = vbase; }
        else          { i0 = vbase + tri_local + 2u; i1 = vbase;                  i2 = vbase + tri_local + 1u; }
    }

    vec4 c0 = clip_verts[i0 * pc.vert_stride_vec4];
    vec4 c1 = clip_verts[i1 * pc.vert_stride_vec4];
    vec4 c2 = clip_verts[i2 * pc.vert_stride_vec4];
    if (floatBitsToUint(c0.w) == 0x7FC0DEADu || floatBitsToUint(c1.w) == 0x7FC0DEADu || floatBitsToUint(c2.w) == 0x7FC0DEADu) return;

    if (any(isnan(c0)) || any(isnan(c1)) || any(isnan(c2)) ||
        any(isinf(c0)) || any(isinf(c1)) || any(isinf(c2))) return;

    // Vulkan 1.3 User Cull Distances (gl_CullDistance[0..3] stored in clip_verts[v*stride + 14]):
    bool has_cull_d = (pc.flags2 & 16u) != 0u;
    if (has_cull_d) {
        uint cull_cnt = min(((pc.flags2 >> 8u) & 7u) + 1u, 4u);
        vec4 cd0 = clip_verts[i0 * pc.vert_stride_vec4 + 14u];
        vec4 cd1 = clip_verts[i1 * pc.vert_stride_vec4 + 14u];
        vec4 cd2 = clip_verts[i2 * pc.vert_stride_vec4 + 14u];
        for (uint ci = 0u; ci < cull_cnt; ++ci) {
            if (cd0[ci] < 0.0 && cd1[ci] < 0.0 && cd2[ci] < 0.0) return;
        }
    }

    bool no_depth_clip = (pc.flags & 2048u) != 0u;
    // Exact homogeneous 4D frustum trivial-reject (valid for ALL w, including w <= 0!)
    if (c0.w <= 1e-5 && c1.w <= 1e-5 && c2.w <= 1e-5) return;
    if ((c0.x + c0.w < 0.0 && c1.x + c1.w < 0.0 && c2.x + c2.w < 0.0) ||
        (c0.w - c0.x < 0.0 && c1.w - c1.x < 0.0 && c2.w - c2.x < 0.0) ||
        (c0.y + c0.w < 0.0 && c1.y + c1.w < 0.0 && c2.y + c2.w < 0.0) ||
        (c0.w - c0.y < 0.0 && c1.w - c1.y < 0.0 && c2.w - c2.y < 0.0)) return;
    if (!no_depth_clip) {
        if (c0.z < 0.0 && c1.z < 0.0 && c2.z < 0.0) return;
        if (c0.z > c0.w && c1.z > c1.w && c2.z > c2.w) return;
    }

    bool has_clip_d = (pc.flags2 & 8u) != 0u;
    uint clip_cnt = has_clip_d ? min(((pc.flags2 >> 5u) & 7u) + 1u, 8u) : 0u;
    bool all_clip_in = true;
    if (has_clip_d) {
        vec4 cl0a = clip_verts[i0 * pc.vert_stride_vec4 + 13u];
        vec4 cl1a = clip_verts[i1 * pc.vert_stride_vec4 + 13u];
        vec4 cl2a = clip_verts[i2 * pc.vert_stride_vec4 + 13u];
        vec4 cl0b = (clip_cnt > 4u) ? clip_verts[i0 * pc.vert_stride_vec4 + 14u] : vec4(0.0);
        vec4 cl1b = (clip_cnt > 4u) ? clip_verts[i1 * pc.vert_stride_vec4 + 14u] : vec4(0.0);
        vec4 cl2b = (clip_cnt > 4u) ? clip_verts[i2 * pc.vert_stride_vec4 + 14u] : vec4(0.0);
        for (uint ci = 0u; ci < clip_cnt; ++ci) {
            float d0 = (ci < 4u) ? cl0a[ci] : cl0b[ci - 4u];
            float d1 = (ci < 4u) ? cl1a[ci] : cl1b[ci - 4u];
            float d2 = (ci < 4u) ? cl2a[ci] : cl2b[ci - 4u];
            if (d0 < 0.0 && d1 < 0.0 && d2 < 0.0) return;
            if (d0 < 0.0 || d1 < 0.0 || d2 < 0.0) all_clip_in = false;
        }
    }

    // CUDARaster Guard-Band trivial-accept: |x|<=4w, |y|<=4w, w>1e-4, and (if depth_clip) 0<=z<=w
    // Keeps projected screen coords strictly within [-4*W, +5*W] -> zero FP32 edge cancellation!
    const float GB = 4.0;
    bool in0 = (c0.w > 1e-4) && (abs(c0.x) <= GB * c0.w) && (abs(c0.y) <= GB * c0.w) && (no_depth_clip || (c0.z >= 0.0 && c0.z <= c0.w));
    bool in1 = (c1.w > 1e-4) && (abs(c1.x) <= GB * c1.w) && (abs(c1.y) <= GB * c1.w) && (no_depth_clip || (c1.z >= 0.0 && c1.z <= c1.w));
    bool in2 = (c2.w > 1e-4) && (abs(c2.x) <= GB * c2.w) && (abs(c2.y) <= GB * c2.w) && (no_depth_clip || (c2.z >= 0.0 && c2.z <= c2.w));

    if (in0 && in1 && in2 && all_clip_in) {
        process_tri(gtid, i0, i1, i2, c0, c1, c2);
        return;
    }

    uint poly_id[10];
    vec4 poly_pos[10];
    poly_id[0] = i0; poly_id[1] = i1; poly_id[2] = i2;
    poly_pos[0] = c0; poly_pos[1] = c1; poly_pos[2] = c2;
    uint n_poly = 3u;

    // 7-plane frustum + up to 8 user gl_ClipDistance[] Sutherland-Hodgman clipper!
    uint total_planes = 7u + clip_cnt;
    for (uint pl = 0u; pl < total_planes && n_poly >= 3u; ++pl) {
        if (no_depth_clip && (pl == 1u || pl == 2u)) continue;
        bool all_in = true, any_in = false;
        float dists[10];
        for (uint e = 0u; e < n_poly; ++e) {
            vec4 p = poly_pos[e];
            float d;
            if (pl == 0u)      d = p.w - 1e-4;
            else if (pl == 1u) d = p.z;
            else if (pl == 2u) d = p.w - p.z;
            else if (pl == 3u) d = p.x + GB * p.w;
            else if (pl == 4u) d = GB * p.w - p.x;
            else if (pl == 5u) d = p.y + GB * p.w;
            else if (pl == 6u) d = GB * p.w - p.y;
            else {
                uint ci = pl - 7u;
                uint slot = (ci < 4u) ? 13u : 14u;
                d = clip_verts[poly_id[e] * pc.vert_stride_vec4 + slot][ci & 3u];
            }
            dists[e] = d;
            if (d < 0.0) all_in = false;
            else         any_in = true;
        }
        if (all_in) continue;
        if (!any_in) { n_poly = 0u; break; }

        uint out_id[10];
        vec4 out_pos[10];
        uint n_out = 0u;
        for (uint e = 0u; e < n_poly; ++e) {
            uint ne = (e + 1u == n_poly) ? 0u : (e + 1u);
            float da = dists[e], db = dists[ne];
            bool a_in = (da >= 0.0), b_in = (db >= 0.0);
            if (a_in && n_out < 10u) {
                out_id[n_out] = poly_id[e];
                out_pos[n_out] = poly_pos[e];
                n_out++;
            }
            if (a_in != b_in && n_out < 10u) {
                float denom = da - db;
                float t = (abs(denom) > 1e-12) ? clamp(da / denom, 0.0, 1.0) : 0.5;
                uint vslot = small_coop ? atomicAdd(s_clip_v, 1u) : atomicAdd(tile_counts[meta_idx], 1u);
                if (vslot >= 900000u) return;
                uint nv = pc.extra_vert_base + vslot;
                emit_interp_vert(nv, poly_id[e], poly_id[ne], t);
                vec4 np = mix(poly_pos[e], poly_pos[ne], t);
                if (pl == 0u)      np.w = max(np.w, 1e-4);
                else if (pl == 1u) np.z = max(np.z, 0.0);
                else if (pl == 2u) { np.w = max(np.w, 1e-4); np.z = min(np.z, np.w); }
                clip_verts[nv * pc.vert_stride_vec4] = np;
                out_id[n_out] = nv;
                out_pos[n_out] = np;
                n_out++;
            }
        }
        for (uint k = 0u; k < n_out; ++k) { poly_id[k] = out_id[k]; poly_pos[k] = out_pos[k]; }
        n_poly = n_out;
    }

    if (n_poly >= 3u) process_tri(gtid, poly_id[0], poly_id[1], poly_id[2], poly_pos[0], poly_pos[1], poly_pos[2]);
    for (uint k = 3u; k < n_poly; ++k) {
        uint tslot = small_coop ? atomicAdd(s_clip_t, 1u) : atomicAdd(tile_counts[meta_idx + 1u], 1u);
        if (tslot < 390000u) process_tri(pc.extra_tri_base + tslot, poly_id[0], poly_id[k - 1u], poly_id[k], poly_pos[0], poly_pos[k - 1u], poly_pos[k]);
    }
}

void main() {
    uint meta_idx = pc.tiles_x * pc.tiles_y;
    bool fused_quad = (pc.flags & 131072u) != 0u;
    bool small_coop = (pc.flags & 65536u) != 0u;
    if (small_coop || fused_quad) {
        if (gl_LocalInvocationIndex == 0u) {
            s_clip_v = 0u; s_clip_t = 0u; s_out_n = 0u;
            s_tx0 = pc.tiles_x; s_ty0 = pc.tiles_y; s_tx1 = 0u; s_ty1 = 0u;
        }
        barrier();
    } else {
        if (gl_LocalInvocationIndex == 0u) s_big_cnt = 0u;
        barrier();
    }

    uint eff_tri_count, eff_tpi, eff_vpi, eff_cv_base, eff_ts_base;
    if (pc.tri_count == 0xFFFFFFFFu) {
        eff_tri_count = tile_counts[meta_idx + 2u];
        eff_tpi       = tile_counts[meta_idx + 3u];
        eff_vpi       = tile_counts[meta_idx + 4u];
        eff_cv_base   = pc.clip_vert_base;
        eff_ts_base   = pc.tri_setup_base;
    } else if ((pc.tri_count & 0xFFFFFF00u) == 0xFFFFFF00u) {
        uint d = 16u + (pc.tri_count & 0xFFu) * 16u;
        eff_tri_count = disp_cmds[d + 8u];
        eff_tpi       = disp_cmds[d + 9u];
        eff_vpi       = disp_cmds[d + 10u];
        eff_cv_base   = disp_cmds[d + 11u];
        eff_ts_base   = disp_cmds[d + 12u];
    } else {
        eff_tri_count = pc.tri_count;
        eff_tpi       = pc.tris_per_inst;
        eff_vpi       = pc.verts_per_inst;
        eff_cv_base   = pc.clip_vert_base;
        eff_ts_base   = pc.tri_setup_base;
    }

    uint tid = gl_GlobalInvocationID.x;
    if (tid < eff_tri_count) {
        run_one_tri(tid, meta_idx, small_coop || fused_quad, eff_tpi, eff_vpi, eff_cv_base, eff_ts_base);
    }

    if (fused_quad) {
        barrier();
        if (gl_LocalInvocationIndex == 0u) {
            tris[8u].idx.x = min(s_out_n, 8u);
        }
    } else if (small_coop) {
        barrier();
        uint out_n = min(s_out_n, 64u);
        uint ntiles = 0u;
        if (out_n > 0u && s_tx0 <= s_tx1 && s_ty0 <= s_ty1) {
            uint bw = s_tx1 - s_tx0 + 1u;
            uint bh = s_ty1 - s_ty0 + 1u;
            ntiles = bw * bh;
            for (uint idx = gl_LocalInvocationIndex; idx < ntiles; idx += 64u) {
                uint tx = s_tx0 + (idx % bw);
                uint ty = s_ty0 + (idx / bw);
                active_tiles[idx] = ty * pc.tiles_x + tx;
            }
        }
        if (gl_LocalInvocationIndex == 0u) {
            tile_counts[meta_idx + 5u] = out_n;
            disp_cmds[8u] = ntiles;
            disp_cmds[9u] = 1u;
            disp_cmds[10u] = 1u;
        }
    } else {
        // 64-way warp-cooperative large-triangle binning (eliminates single-thread 3,600-tile atomic bottleneck!)
        barrier();
        uint nbig = min(s_big_cnt, 64u);
        if (nbig > 0u) {
            bool use_hiz   = (pc.flags & 8192u) != 0u;
            uint dop       = (pc.flags >> 4u) & 7u;
            bool direct_2d = (pc.flags & 32768u) != 0u;
            for (uint b = 0u; b < nbig; ++b) {
                uint btid = s_big_tid[b];
                uvec4 bb  = s_big_bb[b];
                vec2 bz   = s_big_z[b];
                TriSetup bts = tris[btid];
                vec4 be0 = make_edge(bts.v1.xy, bts.v2.xy);
                vec4 be1 = make_edge(bts.v2.xy, bts.v0.xy);
                vec4 be2 = make_edge(bts.v0.xy, bts.v1.xy);
                uint bw   = bb.z - bb.x + 1u;
                uint bh   = bb.w - bb.y + 1u;
                uint tot  = bw * bh;
                for (uint idx = gl_LocalInvocationIndex; idx < tot; idx += 64u) {
                    uint tx = bb.x + (idx % bw);
                    uint ty = bb.y + (idx / bw);
                    if (!tri_overlaps_tile(be0, be1, be2, tx, ty)) continue;
                    uint tile_id = ty * pc.tiles_x + tx;
                    if (use_hiz && !hiz_tile_pass(bz.x, bz.y, tile_hiz[tile_id], dop)) continue;
                    uint slot = atomicAdd(tile_counts[tile_id], 1u);
                    if (slot < pc.max_tris_per_tile) {
                        tile_bins[tile_id * pc.max_tris_per_tile + slot] = btid;
                        if (slot == 0u && !direct_2d) mark_tile_active(tile_id);
                    }
                }
            }
        }
    }
}
