#version 460
// smrast_depth_only.comp — SmRast-VK v0.6:
//   Hybrid Active-Tile / Coherent-2D Depth-Only Pass + Self-Clearing 64-bit VisBuf
#extension GL_ARB_gpu_shader_int64 : require
layout(local_size_x = 16, local_size_y = 16) in;

struct SmTriSetup {
    vec4 v0; vec4 v1; vec4 v2; vec4 area; uvec4 idx;
};

layout(std430, set = 0, binding = 0) readonly buffer TriSetupBuf    { SmTriSetup sm_tris[]; };
layout(std430, set = 0, binding = 1) buffer VisBuf                  { uint64_t sm_vis_px[]; };
layout(std430, set = 0, binding = 2) writeonly buffer DepthBuf      { float sm_depth_px[]; };
layout(std430, set = 0, binding = 3) readonly buffer ActiveTilesBuf { uint sm_active_tiles[]; };

layout(push_constant) uniform DepthOnlyPC {
    uint width;
    uint height;
    uint depth_write;
    uint tiles_x; // bit31 = direct_2d mode
} pc;

void main() {
    uint tx, ty;
    if ((pc.tiles_x & 0x80000000u) != 0u) {
        tx = gl_WorkGroupID.x;
        ty = gl_WorkGroupID.y;
    } else {
        uint tile_id = sm_active_tiles[gl_WorkGroupID.x];
        uint tw = pc.tiles_x & 0x7FFFFFFFu;
        tx = tile_id % tw;
        ty = tile_id / tw;
    }
    uvec2 p = uvec2(tx * 16u + gl_LocalInvocationID.x, ty * 16u + gl_LocalInvocationID.y);
    if (p.x >= pc.width || p.y >= pc.height) return;
    uint pidx = p.y * pc.width + p.x;
    uint64_t vis = sm_vis_px[pidx];
    if (vis == 0xFFFFFFFFFFFFFFFFul) return;
    sm_vis_px[pidx] = 0xFFFFFFFFFFFFFFFFul;
    if (pc.depth_write == 0u) return;
    uint tid = uint(vis & 0xFFFFFFFFul);
    SmTriSetup ts = sm_tris[tid];
    float fx = float(p.x) + 0.5, fy = float(p.y) + 0.5;
    vec2 s0 = ts.v0.xy, s1 = ts.v1.xy, s2 = ts.v2.xy;
    float l0 = ((s2.x - s1.x) * (fy - s1.y) - (s2.y - s1.y) * (fx - s1.x)) * ts.area.x;
    float l1 = ((s0.x - s2.x) * (fy - s2.y) - (s0.y - s2.y) * (fx - s2.x)) * ts.area.x;
    float l2 = 1.0 - l0 - l1;
    float pz = clamp(l0 * ts.v0.z + l1 * ts.v1.z + l2 * ts.v2.z, 0.0, 1.0);
    sm_depth_px[pidx] = pz;
}
