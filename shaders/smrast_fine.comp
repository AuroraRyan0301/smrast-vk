#version 460
// smrast_fine.comp — SmRast-VK v0.6:
//   - Hybrid Active-Tile Indirect Dispatch (small/medium draws) + Coherent 2D Grid Mode (giant 1M+ meshes)
//   - Self-Clearing tile_counts & tile_active_flags (ZERO per-draw CmdFillBuffer!)
//   - 1-Read Persistent Tile Hi-Z with Automatic Live Subgroup Fallback + Watertight Top-Left Fill-Rule
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 16, local_size_y = 16) in;

struct TriSetup {
    vec4 v0;     // sx, sy, ndc_z, inv_w
    vec4 v1;     // sx, sy, ndc_z, inv_w
    vec4 v2;     // sx, sy, ndc_z, inv_w
    vec4 area;   // inv_area, minx, miny, maxx
    uvec4 idx;   // i0, i1, i2, maxy | (is_front << 31)
};

layout(std430, set = 0, binding = 0) readonly buffer TriSetupBuf    { TriSetup tris[]; };
layout(std430, set = 0, binding = 1) buffer TileCountBuf            { uint tile_counts[]; };
layout(std430, set = 0, binding = 2) readonly buffer TileBinsBuf    { uint tile_bins[]; };
layout(std430, set = 0, binding = 3) buffer VisBuf                  { uint64_t vis_px[]; };
layout(std430, set = 0, binding = 4) readonly buffer DepthBuf       { float depth_px[]; };
layout(std430, set = 0, binding = 5) readonly buffer ActiveTilesBuf { uint active_tiles[]; };
layout(std430, set = 0, binding = 6) readonly buffer TileHizBuf     { vec2 tile_hiz[]; };

layout(push_constant) uniform FineParams {
    uint width;
    uint height;
    uint tiles_x;
    uint max_tris_per_tile;
    uint flags;   // bit3=depth_test, bits4..6=depth_op, bit13=use_prebin_hiz, bit15=direct_2d, bit16=small_tri_direct
    uint tiles_y;
} pc;

const uint BATCH = 64u;
shared TriSetup s_tris[BATCH];
shared uint s_tids[BATCH];
shared float s_warp_zmin[32];
shared float s_warp_zmax[32];
shared float s_tile_zmin;
shared float s_tile_zmax;

bool depth_pass(float d, float ref_d, uint op) {
    if (op == 0u) return false;
    if (op == 1u) return d < ref_d;
    if (op == 2u) return d == ref_d;
    if (op == 3u) return d <= ref_d;
    if (op == 4u) return d > ref_d;
    if (op == 5u) return d != ref_d;
    if (op == 6u) return d >= ref_d;
    return true;
}

bool is_top_left(vec2 d) {
    return (d.y < 0.0) || (d.y == 0.0 && d.x > 0.0);
}

float edge_eval(vec2 a, vec2 b, float fx, float fy) {
    if (a.y < b.y || (a.y == b.y && a.x < b.x)) {
        vec2 d = b - a;
        return d.x * (fy - a.y) - d.y * (fx - a.x);
    } else {
        vec2 d = a - b;
        return -(d.x * (fy - b.y) - d.y * (fx - b.x));
    }
}

void main() {
    bool direct_2d        = (pc.flags & 32768u) != 0u;
    bool small_tri_direct = (pc.flags & 65536u) != 0u;
    uint tile_x, tile_y, tile_id;
    if (direct_2d) {
        tile_x = gl_WorkGroupID.x;
        tile_y = gl_WorkGroupID.y;
        tile_id = tile_y * pc.tiles_x + tile_x;
    } else {
        tile_id = active_tiles[gl_WorkGroupID.x];
        tile_x = tile_id % pc.tiles_x;
        tile_y = tile_id / pc.tiles_x;
    }

    uint local_tid = gl_LocalInvocationIndex; // 0..255
    uint flag_idx = pc.tiles_x * pc.tiles_y + 8u + tile_id;
    uint total;
    if (small_tri_direct) {
        total = min(tile_counts[pc.tiles_x * pc.tiles_y + 5u], BATCH);
        if (total == 0u) return;
        if (local_tid < total) {
            uint tid = tile_bins[local_tid];
            s_tids[local_tid] = tid;
            s_tris[local_tid] = tris[tid];
        }
        barrier();
        // Uniform tile-level AABB reject BEFORE touching HBM3 depth_px / vis_px!
        float tx0 = float(tile_x * 16u), ty0 = float(tile_y * 16u);
        float tx1 = tx0 + 16.0, ty1 = ty0 + 16.0;
        bool any_ov = false;
        for (uint k = 0u; k < total; ++k) {
            TriSetup t = s_tris[k];
            if (!(tx1 <= t.area.y || tx0 > t.area.w + 1.0 || ty1 <= t.area.z || ty0 > float(t.idx.w & 0x7FFFFFFFu) + 1.0)) {
                any_ov = true;
                break;
            }
        }
        if (!any_ov) return;
    } else {
        total = min(tile_counts[tile_id], pc.max_tris_per_tile);
        if (total == 0u) {
            if (!direct_2d && local_tid == 0u) tile_counts[flag_idx] = 0u;
            return;
        }
    }

    uvec2 p = uvec2(tile_x * 16u + gl_LocalInvocationID.x, tile_y * 16u + gl_LocalInvocationID.y);
    bool in_bounds = (p.x < pc.width && p.y < pc.height);
    uint pidx = in_bounds ? (p.y * pc.width + p.x) : 0u;
    float fx = float(p.x) + 0.5;
    float fy = float(p.y) + 0.5;

    bool dtest = (pc.flags & 8u) != 0u;
    uint dop = (pc.flags >> 4u) & 7u;
    bool greater_wins = (dop == 4u || dop == 6u);
    bool hiz_less    = dtest && (dop == 1u || dop == 3u);
    bool hiz_greater = dtest && (dop == 4u || dop == 6u);
    bool use_prebin_hiz = (pc.flags & 8192u) != 0u;

    float ref_d = in_bounds ? depth_px[pidx] : (greater_wins ? 1.0 : 0.0);
    uint64_t best = in_bounds ? vis_px[pidx] : 0xFFFFFFFFFFFFFFFFul;
    uint bin_base = tile_id * pc.max_tris_per_tile;

    // 1-read persistent Tile Hi-Z (fast path) or 2-level live subgroup+shared reduction fallback!
    float tile_zmin = 0.0, tile_zmax = 1.0;
    if (hiz_less || hiz_greater) {
        if (use_prebin_hiz) {
            vec2 hz = tile_hiz[tile_id];
            tile_zmin = hz.x;
            tile_zmax = hz.y;
        } else {
            float wmin = subgroupMin(in_bounds ? ref_d : 1e30);
            float wmax = subgroupMax(in_bounds ? ref_d : -1e30);
            if (subgroupElect()) {
                s_warp_zmin[gl_SubgroupID] = wmin;
                s_warp_zmax[gl_SubgroupID] = wmax;
            }
            barrier();
            if (local_tid == 0u) {
                float mn = 1e30, mx = -1e30;
                for (uint w = 0u; w < gl_NumSubgroups; ++w) {
                    mn = min(mn, s_warp_zmin[w]);
                    mx = max(mx, s_warp_zmax[w]);
                }
                s_tile_zmin = mn;
                s_tile_zmax = mx;
            }
            barrier();
            tile_zmin = s_tile_zmin;
            tile_zmax = s_tile_zmax;
        }
    }

    for (uint base = 0u; base < total; base += BATCH) {
        uint count = min(BATCH, total - base);
        if (!small_tri_direct) {
            if (local_tid < count) {
                uint tid = tile_bins[bin_base + base + local_tid];
                s_tids[local_tid] = tid;
                s_tris[local_tid] = tris[tid];
            }
            barrier();
        }

        if (in_bounds) {
            for (uint k = 0u; k < count; ++k) {
                TriSetup t = s_tris[k];
                if (hiz_less) {
                    float tri_min_z = clamp(min(t.v0.z, min(t.v1.z, t.v2.z)), 0.0, 1.0);
                    if (dop == 1u ? (tri_min_z >= tile_zmax) : (tri_min_z > tile_zmax)) continue;
                } else if (hiz_greater) {
                    float tri_max_z = clamp(max(t.v0.z, max(t.v1.z, t.v2.z)), 0.0, 1.0);
                    if (dop == 4u ? (tri_max_z <= tile_zmin) : (tri_max_z < tile_zmin)) continue;
                }
                if (fx < t.area.y || fx > t.area.w + 1.0 || fy < t.area.z || fy > float(t.idx.w & 0xFFFFu) + 1.0)
                    continue;
                vec2 s0 = t.v0.xy, s1 = t.v1.xy, s2 = t.v2.xy;
                float e0 = edge_eval(s1, s2, fx, fy);
                float e1 = edge_eval(s2, s0, fx, fy);
                float e2 = edge_eval(s0, s1, fx, fy);
                if ((is_top_left(s2 - s1) ? (e0 < 0.0) : (e0 <= 0.0)) ||
                    (is_top_left(s0 - s2) ? (e1 < 0.0) : (e1 <= 0.0)) ||
                    (is_top_left(s1 - s0) ? (e2 < 0.0) : (e2 <= 0.0))) continue;

                float l0 = e0 * t.area.x;
                float l1 = e1 * t.area.x;
                float l2 = 1.0 - l0 - l1;
                float d = clamp(l0 * t.v0.z + l1 * t.v1.z + l2 * t.v2.z, 0.0, 1.0);
                if (dtest && !depth_pass(d, ref_d, dop)) continue;

                uint64_t cand;
                if (!dtest || dop == 7u) {
                    cand = (uint64_t(~s_tids[k]) << 32) | uint64_t(s_tids[k]);
                } else {
                    uint d_u32 = floatBitsToUint(greater_wins ? (1.0 - d) : d);
                    cand = (uint64_t(d_u32) << 32) | uint64_t(s_tids[k]);
                }
                if (cand < best) best = cand;
            }
        }
        if (!small_tri_direct) barrier();
    }

    // Self-clear tile_counts & active flag for this tile (ZERO per-draw CmdFillBuffer!)
    if (!small_tri_direct && local_tid == 0u) {
        tile_counts[tile_id] = 0u;
        if (!direct_2d) tile_counts[flag_idx] = 0u;
    }

    if (in_bounds && best != 0xFFFFFFFFFFFFFFFFul) {
        vis_px[pidx] = best;
    }
}
